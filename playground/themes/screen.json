{
	"$schema": "vscode://schemas/color-theme",
	"name": "The screen",
	"type": "dark",
	"colors": {
		"titleBar.activeBackground": "#ebebeb",
		"titleBar.activeForeground": "#141414",
		"menubar.selectionBackground": "#dedede",
		"editor.background": "#181818",
		"editor.foreground": "#ebebeb",
		"foreground": "#bebebe",
		"strongForeground": "#ffffff",
		"descriptionForeground": "#8f8f8f",
		"focusBorder": "#f79643",
		"editorError.foreground": "#f87063",
		"editorGroup.border": "#020202",
		"panel.border": "#2e2e2e",
		"list.hoverBackground": "#ffffff1c",
		"list.inactiveSelectionBackground": "#ffffff17",
		"input.background": "#00000033",
		"menu.background": "#242424",
		"menu.selectionBackground": "#383838",
		"menu.selectionForeground": "#ffffff",
		"editorHoverWidget.background": "#242424",
		"sideBar.background": "#00000000",
		"editorGroupHeader.tabsBackground": "#00000000",
		"tab.activeBackground": "#242424",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveForeground": "#868686",
		"button.background": "#ffffff",
		"button.foreground": "#181818",
		"button.secondaryBackground": "#ffffff14",
		"radio.inactiveBorder": "#00000073",
		"radio.inactiveBackground": "#1e1e1e",
		"radio.activeBackground": "#00000066",
		"radio.activeForeground": "#ffffff",
		"scrollbarSlider.background": "#bebebe4d",
		"editorCursor.foreground": "#ffffff",
		"editor.selectionBackground": "#ffffff1a",
		"editor.inactiveSelectionBackground": "#ffffff1a",
		"editor.rangeHighlightBackground": "#ffffff0a",
		"editorWhitespace.foreground": "#ffffff1f",
		"editor.lineHighlightBackground": "#ffffff08",
		"editorLineNumber.foreground": "#6e6e6e",
		"editor.selectionHighlightBackground": "#ffffff12",
		"audio.waveform": "#b7b7b7",
		"audio.spectrumSelectionBackground": "#ffffff29",
		"audio.spectrumInactiveSelectionBackground": "#ffffff29",
		"audio.slabShade": "#0c0c0c",
		"audio.keyHighlight": "#ffffff1f",
		"audio.keyShadow": "#000000b3"
	},
	"tokenColors": [
		{ "scope": "storage", "settings": { "foreground": "#ffffff" } },
		{ "scope": "keyword", "settings": { "foreground": "#ffffff" } },
		{ "scope": "entity.name.function", "settings": { "foreground": "#ebebeb" } },
		{ "scope": ["variable", "entity.name.type"], "settings": { "foreground": "#bebebe" } },
		{ "scope": ["string", "constant"], "settings": { "foreground": "#989898" } },
		{ "scope": "comment", "settings": { "foreground": "#868686" } },
		{ "scope": "markup.heading", "settings": { "foreground": "#bebebe" } }
	]
}
