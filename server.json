  "websiteUrl": "https://github.com/audiojs/audio",
  "icons": [{ "src": "https://raw.githubusercontent.com/audiojs/audio/master/assets/logo.svg", "mimeType": "image/svg+xml", "sizes": ["any"] }],
  "version": "2.10.0",
  "packages": [{
    "registryType": "npm",
    "identifier": "audio",
    "version": "2.10.0",
    "transport": { "type": "stdio" },
    "packageArguments": [{ "type": "positional", "value": "--mcp" }]
  }]
}
