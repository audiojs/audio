{
  "name": "audio",
  "version": "2.14.0",
  "description": "High-level audio manipulations: loading, playback, analysis and editing. 140+ plugins: denoise, dynamics, EQ, filters, effects, reverb, time and pitch, spatial, synthesis, music analysis.",
  "type": "module",
  "main": "audio.js",
  "exports": {
    ".": {
      "browser": "./dist/audio.js",
      "default": "./audio.js"
    },
    "./core": "./core.js",
    "./plan": "./plan.js",
    "./stats": "./stats.js",
    "./cache": "./cache.js",
    "./batch": "./batch.js",
    "./stream": "./batch.js",
    "./worker": {
      "types": "./worker.d.ts",
      "default": "./worker.js"
    },
    "./worker-host": "./worker.js",
    "./parallel": "./parallel.js",
    "./polyfill": {
      "types": "./polyfill.d.ts",
      "default": "./polyfill.js"
    },
    "./fn/*": "./fn/*"
  },
  "types": "./audio.d.ts",
  "bin": "./bin/cli.js",
  "license": "MIT",
  "repository": "audiojs/audio",
  "mcpName": "io.github.audiojs/audio",
  "files": [
    "core.js",
    "audio.js",
    "audio.d.ts",
    "batch.js",
    "plan.js",
    "stats.js",
    "cache.js",
    "worker.js",
    "worker.d.ts",
    "parallel.js",
    "deck.js",
    "polyfill.js",
    "polyfill.d.ts",
    "fn/",
    "bin/",
    "skills/",
    "dist/"
  ],
  "keywords": [
    "audiojs",
    "audio",
    "dsp",
    "pcm",
    "mcp"
  ],
  "scripts": {
    "build": "node .esbuild.js",
    "serve": "node .site-build.js && node .site-serve.js",
    "test": "node test/run.js",
    "test:cli": "TST_PARALLEL=3 node test/cli.js",
    "test:fixes": "node test/fix-deps.js && node test/fix-plan.js && node test/fix-core.js && node test/fix-meta.js && node test/fix-worker.js",
    "test:batch": "node --test test/batch.test.js",
    "test:browser": "node test/browser.js",
    "test:site": "node --test test/site.test.js",
    "test:playground": "node --test test/playground.test.js",
    "test:memory": "node --test test/memory*.test.js",
    "test:mcp": "node test/mcp.js",
    "test:bridge": "node test/bridge.js",
    "test:node": "CI=1 npm test && CI=1 npm run test:fixes && CI=1 npm run test:batch && CI=1 npm run test:cli && npm run test:stream && npm run test:mcp",
    "test:pages": "npm run test:memory && npm run test:browser && npm run test:playground",
    "test:polyfill": "node test/polyfill.js",
    "test:all": "npm run test:node && npm run test:pages",
    "version": "node -p \"var s=require('fs'),v=require('./package.json').version;s.writeFileSync('core.js',s.readFileSync('core.js','utf8').replace(/audio\\.version = '[^']+'/,'audio.version = \\''+v+'\\''));''\" && git add core.js",
    "prepublishOnly": "npm run version && npm run build && npm run test:node",
    "demo": "vhs docs/player.tape",
    "bench": "node bench/bench.js",
    "test:stream": "node test/stream.js",
    "test:live": "node test/live.js"
  },
